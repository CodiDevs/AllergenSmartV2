# === Supabase ===
SUPABASE_URL=https://xxxxx.supabase.co
# Nueva key (Publishable) - reemplaza a la antigua 'anon' key - segura para frontend
SUPABASE_ANON_KEY=sb_publishable_...
# Nueva key (Secret) - reemplaza a la antigua 'service_role' - SOLO backend, nunca frontend
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# === Google Cloud (mockeado hasta activar Vision API) ===
GOOGLE_CLOUD_API_KEY=AIzaSy...

# === App ===
ENVIRONMENT=development
APP_NAME=AllergenSmart API
APP_VERSION=2.0.0
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=10

# === Monitoring (INACTIVO hasta producción; el init de Sentry está comentado en main.py) ===
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
